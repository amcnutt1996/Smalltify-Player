# Spotify Developer app Client ID (https://developer.spotify.com/dashboard)
# Add redirect URI: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify Soloist API key, lets this computer play music itself
# (generate one at https://developer.spotify.com/dashboard/soloist; keep it secret)
SOLOIST_API_KEY=
# Text size in the app: small, default, large or extra-large (Settings in the
# app changes it and saves it here)
#UI_FONT_SIZE=default
